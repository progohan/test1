{
  "name": "eduardo-portfolio-test1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.22.1",
    "npm": "11.9.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "node scripts/validate-content.ts && node scripts/validate-cv.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck:tests": "tsc --project tsconfig.tests.json",
    "check": "npm run lint && npm run typecheck:tests && npm run validate:content && npm test && npm run build && npm run check:dist",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "install-and-build": "npm ci && npm run check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.0",
    "lucide-react": "^0.364.0",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.12.4",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "jsdom": "30.1.3",
    "postcss": "^8.5.31",
    "tailwindcss": "v3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "tailwindcss-animate": "^1.0.7"
  }
}
